  "item": [
    {
      "name": "[200] Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "  pm.test(\"Status é 200\", function () {\r\n       pm.response.to.have.status(200);\r\n   });\r\n   \r\n   pm.test(\"Resposta traz o token\", function () {\r\n       const corpo = pm.response.json();\r\n       pm.expect(corpo.accessToken).to.be.a(\"string\").and.not.empty;\r\n       pm.collectionVariables.set(\"token\", corpo.accessToken);\r\n   });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\"usuario\":\"qa.teste\",\"senha\":\"Teste@12345\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[401] Login com senha incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.test(\"Status é 401\", function () {\r\n       pm.response.to.have.status(401);\r\n   });\r\n\r\n   pm.test(\"Resposta é ProblemDetails de não autorizado\", function () {\r\n       const corpo = pm.response.json();\r\n       pm.expect(corpo.status).to.eql(401);\r\n       pm.expect(corpo.title).to.eql(\"Não autorizado\");\r\n   });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\"usuario\":\"qa.teste\",\"senha\":\"senha-incorreta\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[401] Listagem de animais sem token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.test(\"Status é 401\", function () {\r\n       pm.response.to.have.status(401);\r\n   });\r\n\r\n   pm.test(\"Não expõe dados de animais\", function () {\r\n       pm.expect(pm.response.text()).to.not.match(/rga/i);\r\n   });"
            ]
          }
        }
      ],
