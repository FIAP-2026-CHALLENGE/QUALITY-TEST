    {
      "name": "[201] Cadastro de responsável com token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   const cpf = String(Math.floor(Math.random() * 1e11)).padStart(11, \"0\");\r\n   pm.collectionVariables.set(\"cpfTeste\", cpf);\r\n   pm.collectionVariables.set(\"emailTeste\", \"qa.\" + cpf + \"@email.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.test(\"Status é 201\", function () {\r\n       pm.response.to.have.status(201);\r\n   });\r\n\r\n   pm.test(\"Responsável criado com id e CPF enviado\", function () {\r\n       const corpo = pm.response.json();\r\n       pm.expect(corpo.id).to.be.a(\"number\");\r\n       pm.expect(corpo.cpf).to.eql(pm.collectionVariables.get(\"cpfTeste\"));\r\n   });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\r\n     \"name\": \"Responsável QA Automatizado\",\r\n     \"email\": \"{{emailTeste}}\",\r\n     \"phone\": \"11977776666\",\r\n     \"cpf\": \"{{cpfTeste}}\"\r\n   }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/responsaveis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "responsaveis"
          ]
        }
      },
      "response": []
    }
